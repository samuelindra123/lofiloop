{
  "identifier": "dev.lofiloop.desktop",
  "productName": "LofiLoop",
  "version": "0.2.3",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LofiLoop",
        "width": 1120,
        "height": 780,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}